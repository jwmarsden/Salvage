// Waybar config for sway on salvage.
// Reload after editing: Command+Shift+C (reloads sway, which restarts the bar).
{
  "layer": "top",
  "position": "top",
  "height": 30,

  "modules-left": [
    "custom/chrome",
    "custom/terminal",
    "custom/vscode",
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "power-profiles-daemon", "battery", "tray"],

  // App launchers: click to open.
  "custom/chrome": {
    "format": "",
    "tooltip-format": "Google Chrome",
    "on-click": "google-chrome-stable"
  },
  "custom/terminal": {
    "format": "",
    "tooltip-format": "Terminal",
    "on-click": "alacritty"
  },
  "custom/vscode": {
    "format": "󰨞",
    "tooltip-format": "VS Code",
    "on-click": "code"
  },

  "sway/workspaces": {
    "disable-scroll": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  // Click to open the volume mixer; scroll to change volume.
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": { "headphone": "", "default": ["", "", ""] },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " wired",
    "format-disconnected": " offline",
    "tooltip-format": "{ifname} {ipaddr}"
  },

  // Power mode: click to cycle performance / balanced / power-saver.
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power mode: {profile}\nClick to change",
    "format-icons": {
      "default": "󰗑",
      "performance": "󰓅",
      "balanced": "󰗑",
      "power-saver": "󰌪"
    }
  },

  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "tray": {
    "spacing": 8
  }
}
