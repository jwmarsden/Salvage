// Waybar config for sway on salvage.
// Reload after editing: Command+Shift+C (reloads sway, which restarts the bar).
// Every module has "cursor": false, so hovering keeps the normal arrow instead
// of waybar's hand pointer on clickable modules.
{
  "layer": "top",
  "position": "top",
  "height": 30,

  "modules-left": [
    "custom/thunar",
    "custom/chrome",
    "custom/terminal",
    "custom/vscode",
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "custom/vpn", "custom/onedrive", "network", "power-profiles-daemon", "temperature", "battery", "tray"],

  // App launchers: click to open.
  "custom/thunar": {
    "cursor": false,
    "format": "",
    "tooltip-format": "Files (Thunar)",
    "on-click": "thunar"
  },
  "custom/chrome": {
    "cursor": false,
    "format": "",
    "tooltip-format": "Google Chrome",
    "on-click": "google-chrome-stable"
  },
  "custom/terminal": {
    "cursor": false,
    "format": "",
    "tooltip-format": "Terminal",
    "on-click": "foot"
  },
  "custom/vscode": {
    "cursor": false,
    "format": "󰨞",
    "tooltip-format": "VS Code",
    "on-click": "code"
  },

  "sway/workspaces": {
    "cursor": false,
    "disable-scroll": true,
    // Number plus a small icon for each app open on the workspace.
    "format": "{name} <span size='small'>{windows}</span>",
    "window-format": "{}",
    "format-window-separator": " ",
    "window-rewrite-default": "\uf2d0",
    "window-rewrite": {
      "class<.*chrome.*>": "",
      "class<.*firefox.*>": "",
      "class<foot>": "",
      "class<code.*>": "󰨞",
      "class<[Tt]hunar>": "",
      "class<.*[Oo]bsidian.*>": "",
      "class<.*qgis.*>": "",
      "class<vlc>": "󰕼",
      "class<.*qbittorrent.*>": "",
      "class<.*podman.*>": "",
      "class<.*pavucontrol.*>": "",
      "class<.*steam.*>": "",
      "class<DBeaver>": "󰆼",
      "class<Tkmoo>": "󰆚",
      "class<jetbrains-pycharm>": "",
      // Nerd Fonts has no crab, so use the one-colour Noto Emoji one
      // (U+FE0E asks for the text-style glyph, not the colour emoji)
      "class<jetbrains-rustrover>": "<span font='Noto Emoji'>🦀\ufe0e</span>",
      // Mudlet: the Noto Emoji cow (tkMOO-light has the Nerd Fonts one); its
      // app_id comes from a patch in configuration.nix
      "class<mudlet>": "<span font='Noto Emoji'>🐄\ufe0e</span>"
    }
  },

  "clock": {
    "cursor": false,
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    // Hover calendar in Tokyo Night: week numbers on the left, today as a
    // blue block. Scroll over the clock to flip months; right-click for the
    // year (back to the month view on the next right-click).
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#c0caf5'><b>{}</b></span>",
        "weekdays": "<span color='#7aa2f7'><b>{}</b></span>",
        "weeks":    "<span color='#565f89'>{:%V}</span>",
        "days":     "<span color='#a9b1d6'>{}</span>",
        "today":    "<span background='#7aa2f7' color='#1a1b26'><b>{}</b></span>"
      }
    },
    // Click: today's Daily note in Obsidian (the Journals plugin's own
    // obsidian://journals link; creates it from the template if needed), then
    // jump to Obsidian's workspace.
    "on-click": "xdg-open 'obsidian://journals?vault=JWMVault&journal=Daily'; sleep 1; swaymsg -q '[app_id=md.obsidian.Obsidian] focus'",
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    }
  },

  // Click to open the volume mixer; scroll to change volume.
  "pulseaudio": {
    "cursor": false,
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": { "headphone": "", "default": ["", "", ""] },
    "on-click": "pavucontrol",
    "max-volume": 100,
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "custom/vpn": {
    "cursor": false,
    "exec": "waybar-vpn",
    "return-type": "json",
    "interval": 15,
    "signal": 8,
    "on-click": "waybar-vpn toggle",
    "on-click-right": "nordvpn-gui"
  },
  // OneDrive sync status from the onedrive@onedrive service log.
  "custom/onedrive": {
    "cursor": false,
    "exec": "waybar-onedrive",
    "return-type": "json",
    "interval": 5,
    "on-click": "foot journalctl --user -fu onedrive@onedrive -o cat",
    "on-click-right": "systemctl --user restart onedrive@onedrive"
  },
  "network": {
    "cursor": false,
    // Icon only (signal strength); the network name is in the tooltip.
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\nClick: pick a network  Right-click: settings",
    "tooltip-format": "{ifname} {ipaddr}\nClick: pick a network  Right-click: settings",
    "on-click": "foot nmtui connect",
    "on-click-right": "nm-connection-editor"
  },

  // Power mode: click to cycle performance / balanced / power-saver.
  "power-profiles-daemon": {
    "cursor": false,
    "format": "{icon}",
    "tooltip-format": "Power mode: {profile}\nClick to change",
    "format-icons": {
      "default": "󰗑",
      "performance": "󰓅",
      "balanced": "󰗑",
      "power-saver": "󰌪"
    }
  },

  // CPU package temperature (fanless: it throttles itself at 100°C).
  // Turns red from 90°C; click for btop.
  "temperature": {
    "cursor": false,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 90,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["\uf2cb", "\uf2ca", "\uf2c9", "\uf2c8", "\uf2c7"],
    "tooltip-format": "CPU package: {temperatureC}°C",
    "on-click": "foot btop"
  },

  "battery": {
    "cursor": false,
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "tray": {
    "cursor": false,
    "spacing": 6
  }
}
